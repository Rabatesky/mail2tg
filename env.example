# ── Telegram ──────────────────────────────────────────────
# Токен бота от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=
# Ваш chat_id. Узнать: нажмите «Старт» у бота, затем
#   .venv/bin/python mail2tg.py --get-chat-id
TELEGRAM_CHAT_ID=
# Необязательно: прокси для Telegram, если api.telegram.org недоступен с сервера
# Примеры: socks5://user:pass@1.2.3.4:1080   http://1.2.3.4:3128
TELEGRAM_PROXY=

# ── Почта (Gmail) ─────────────────────────────────────────
# Полный адрес Gmail
IMAP_USER=you@gmail.com
# ПАРОЛЬ ПРИЛОЖЕНИЯ (16 букв), а НЕ обычный пароль от Google.
# Создать: https://myaccount.google.com/apppasswords (нужна двухэтапная аутентификация).
# Пробелы можно оставить как есть — скрипт их уберёт.
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# ssl | starttls | plain
IMAP_SECURITY=ssl
IMAP_VERIFY_TLS=true
# Папка. INBOX — входящие (включая вкладки «Промоакции», «Соцсети»).
IMAP_FOLDER=INBOX

# ── Что пересылать ────────────────────────────────────────
# Адреса отправителей через запятую. Можно указать целый домен: @example.com
# Пусто = пересылать ВСЕ письма из папки.
FROM_FILTER=author@example.com

# Как часто проверять почту, секунд (не меньше 10)
POLL_INTERVAL=60
# Пересылать вложения файлами (true/false)
SEND_ATTACHMENTS=true
# Максимальный размер вложения, МБ (лимит Telegram для ботов — 50)
MAX_ATTACHMENT_MB=20
# Обрезать текст письма длиннее N символов (0 = не обрезать)
MAX_BODY_CHARS=12000
# Показывать ссылки из HTML-писем в скобках после текста ссылки
SHOW_LINKS=false

# ── Перевод (бесплатно, без ключей) ───────────────────────
# Переводить письма (тему и текст). Приходит только перевод.
TRANSLATE=true
# Переводчики по порядку: если первый не сработал, пробуется следующий.
#   google   — Google Translate, хорошее качество, без лимитов (неофициальный доступ)
#   mymemory — запасной, качество хуже, 5 000 символов в день (50 000 с MYMEMORY_EMAIL)
TRANSLATE_PROVIDERS=google,mymemory
# Необязательно: ваш email для MyMemory — повышает дневной лимит в 10 раз
MYMEMORY_EMAIL=
# С какого языка (en, de, ... или auto — определить автоматически)
TRANSLATE_FROM=en
# На какой язык
TRANSLATE_TO=ru
# Необязательно: прокси для Google Translate, если он недоступен с сервера
TRANSLATE_PROXY=

# При первом запуске переслать N последних писем от автора (для проверки). 0 = только новые.
BACKFILL_ON_FIRST_RUN=1

# Файл, где хранится номер последнего обработанного письма
STATE_FILE=state.json
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
